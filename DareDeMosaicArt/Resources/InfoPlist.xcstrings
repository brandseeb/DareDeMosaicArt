    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to capture real-world colors for your mosaic art pieces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイクアートに必要な色をカメラで撮影して集めるためにカメラを使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save your completed mosaic artwork to your photo library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完成したモザイクアートをカメラロールに保存するために使用します。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to select target photos and match mosaic pieces from your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モザイクアートの元画像を選択し、ライブラリの写真からピースを見つけるために写真を使用します。"
          }
        }
      }
    }
  },
  "version": "1.0"

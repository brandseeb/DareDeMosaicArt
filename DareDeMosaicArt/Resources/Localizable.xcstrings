    "mission.hint.dark": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影、黒い服、モニターの枠、夜の景色などを狙ってみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for shadows, dark clothing, monitor frames, or night scenes!"
          }
        }
      }
    },
    "mission.hint.white": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白い壁、紙、白いシャツ、雲などを狙ってみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for white walls, paper, shirts, or clouds!"
          }
        }
      }
    },
    "mission.hint.brightGreen": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "若葉、ライム、明るい緑の小物などを探してみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for fresh leaves, limes, or bright green items!"
          }
        }
      }
    },
    "mission.hint.blue": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "青空、海、ジーンズ、文房具、青いペットボトルなどを探してみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for the blue sky, ocean, jeans, stationery, or bottles!"
          }
        }
      }
    },
    "mission.hint.green": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観葉植物、公園の芝生、街路樹、緑色のパッケージなどを探してみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for houseplants, park grass, street trees, or green packaging!"
          }
        }
      }
    },
    "mission.hint.red": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "花、看板、服、トマト、赤い小物などを探してみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for flowers, signs, clothes, tomatoes, or red items!"
          }
        }
      }
    },
    "mission.hint.orangeYellow": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルーツ、文具、照明、オレンジ色のパッケージなどを探してみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for fruits, stationery, lighting, or orange packaging!"
          }
        }
      }
    },
    "mission.hint.general": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "身の回りのものをカメラでかざして、色が合う場所を探してみよう！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point your camera around you to find matching colors!"
          }
        }
      }
    },
    "gameMode.fullHunt.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全マス撮影 (じっくり)"

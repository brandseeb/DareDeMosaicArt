        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Hunt Only (Classic)"
          }
        }
      }
    },
    "gameMode.fullHunt.description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのマスを現実世界のカメラ撮影で埋めていく、究極のモザイクアート体験。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill every tile with real-world camera photos for an authentic mosaic experience."
          }
        }
      }
    },
    "gameMode.hybrid.title": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末写真＋不足色撮影 (おすすめ)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo Library + Camera (Recommended)"
          }
        }
      }
    },
    "gameMode.hybrid.description": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホ内の写真を自動で当てはめ、足りない色だけを日常からカメラで探して完成させるモード。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-matches photos from your library and lets you capture missing colors with the camera."
          }
        }
      }
    },
